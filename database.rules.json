{
  "rules": {
    "memories": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'REPLACE_WITH_YOUR_ADMIN_EMAIL'",
      "$memoryId": {
        ".validate": "newData.hasChildren(['title', 'text', 'category', 'createdAt'])",
        "title": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "category": { ".validate": "newData.isString()" },
        "imageUrl": { ".validate": "newData.isString() || !newData.exists()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber() || !newData.exists()" },
        "createdBy": { ".validate": "newData.isString() || !newData.exists()" },
        "updatedBy": { ".validate": "newData.isString() || !newData.exists()" },
        "$other": { ".validate": false }
      }
    }
  }
}